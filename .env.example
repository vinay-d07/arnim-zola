# Groq API Key (required) - Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Default Model (optional) - Options: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b, qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-20b

# Auto approve tool executions without asking (true/false)
GROQ_AUTO_APPROVE=false
