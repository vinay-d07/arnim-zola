# Velona API Key (default provider) - Create one at https://velona.in/keys
VELONA_API_KEY=your_velona_api_key_here

# Groq API Key (optional) - only needed for the openai/gpt-oss-* and qwen/qwen3.x Groq models
# GROQ_API_KEY=your_groq_api_key_here

# Default Model (optional) - e.g. deepseek/deepseek-v4-pro, deepseek/deepseek-v4-flash, qwen/qwen3-coder
LLM_MODEL=deepseek/deepseek-v4-pro

# Provider for model IDs not in the built-in list (velona | groq). Defaults to velona.
# LLM_PROVIDER=velona

# Auto approve tool executions without asking (true/false)
GROQ_AUTO_APPROVE=false
