{
  "name": "@vinay-d02/zola",
  "version": "1.0.0",
  "description": "A lightweight coding agent harness for any OpenAI-compatible LLM provider (Velona, Groq), written in TypeScript",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "zola": "./dist/index.js"
  },
  "author": "vinay <vinaydhh@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinay-d07/arnim-zola.git"
  },
  "homepage": "https://github.com/vinay-d07/arnim-zola#readme",
  "bugs": "https://github.com/vinay-d07/arnim-zola/issues",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
