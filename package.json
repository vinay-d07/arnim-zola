    "diff": "^9.0.0",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "openai": "^7.23.0",
    "ora": "^9.4.1"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/marked-terminal": "^6.1.1",
